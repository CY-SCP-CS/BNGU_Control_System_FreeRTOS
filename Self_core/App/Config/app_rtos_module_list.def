/* 外部数据源诊断清单：稳定 ID、稳定数字、显示名、允许数据年龄 tick、板型掩码。
 * 生产者发布有效性/有效数据时间；健康任务不认识该设备的原始数据结构。
 */
APP_MODULE(MODULE_IMU, 0, "IMU", 10U, APP_BOARD_IMU_MASK)
APP_MODULE(MODULE_MOTOR0, 1, "motor0", 50U, APP_BOARD_CAN_MASK)
APP_MODULE(MODULE_MOTOR1, 2, "motor1", 50U, APP_BOARD_CAN_MASK)
APP_MODULE(MODULE_MOTOR2, 3, "motor2", 50U, APP_BOARD_CAN_MASK)
APP_MODULE(MODULE_MOTOR3, 4, "motor3", 50U, APP_BOARD_CAN_MASK)
APP_MODULE(MODULE_MOTOR4, 5, "motor4", 50U, (APP_BOARD_CAN_MASK & APP_BOARD_GIMBAL_MASK))
APP_MODULE(MODULE_MOTOR5, 6, "motor5", 50U, (APP_BOARD_CAN_MASK & APP_BOARD_GIMBAL_MASK))
APP_MODULE(MODULE_DBUS, 7, "DBUS", 100U, APP_BOARD_DBUS_MASK)
APP_MODULE(MODULE_CAN_COMMAND, 8, "CAN1 command", 200U, APP_BOARD_CAN_MASK)
APP_MODULE(MODULE_CHASSIS_OMEGA, 9, "chassis omega", 20U,
           (APP_BOARD_CAN_MASK & APP_BOARD_GIMBAL_MASK))
APP_MODULE(MODULE_POWER, 10, "power meter", 100U, (APP_BOARD_CAN_MASK & APP_BOARD_CHASSIS_MASK))
APP_MODULE(MODULE_REFEREE, 11, "referee", 1000U, APP_BOARD_REFEREE_MASK)
