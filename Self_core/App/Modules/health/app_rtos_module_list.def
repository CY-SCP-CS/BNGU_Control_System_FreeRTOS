/* 外部数据源诊断清单：稳定 ID、稳定数字、显示名、允许数据年龄 tick、板型掩码。
 * 生产者发布有效性/有效数据时间；健康任务不认识该设备的原始数据结构。
 */
APP_MODULE(MODULE_IMU, 0, "IMU", (CURRENT_ROBOT == ROBOT_NAVIGATION ? APP_INPUT_NAV_IMU_MAX_AGE_MS : APP_INPUT_IMU_MAX_AGE_MS), APP_BOARD_IMU_MASK)
APP_MODULE(MODULE_MOTOR0, 1, "motor0", APP_INPUT_MOTOR_MAX_AGE_MS, APP_BOARD_MOTOR_MASK)
APP_MODULE(MODULE_MOTOR1, 2, "motor1", APP_INPUT_MOTOR_MAX_AGE_MS, APP_BOARD_MOTOR_MASK)
APP_MODULE(MODULE_MOTOR2, 3, "motor2", APP_INPUT_MOTOR_MAX_AGE_MS, APP_BOARD_MOTOR_MASK)
APP_MODULE(MODULE_MOTOR3, 4, "motor3", APP_INPUT_MOTOR_MAX_AGE_MS, APP_BOARD_MOTOR_MASK)
APP_MODULE(MODULE_MOTOR4, 5, "motor4", APP_INPUT_MOTOR_MAX_AGE_MS, APP_BOARD_EXTRA_MOTOR_MASK)
APP_MODULE(MODULE_MOTOR5, 6, "motor5", APP_INPUT_MOTOR_MAX_AGE_MS, APP_BOARD_EXTRA_MOTOR_MASK)
APP_MODULE(MODULE_DBUS, 7, "DBUS", APP_INPUT_DBUS_MAX_AGE_MS, APP_BOARD_DBUS_MASK)
APP_MODULE(MODULE_CAN_COMMAND, 8, "CAN1 command", APP_INPUT_CAN_MAX_AGE_MS, APP_BOARD_MOTOR_MASK)
APP_MODULE(MODULE_CHASSIS_OMEGA, 9, "chassis omega", APP_INPUT_OMEGA_MAX_AGE_MS,
           APP_BOARD_EXTRA_MOTOR_MASK)
APP_MODULE(MODULE_POWER, 10, "power meter", APP_INPUT_POWER_MAX_AGE_MS, APP_BOARD_POWER_MASK)
APP_MODULE(MODULE_REFEREE, 11, "referee", 1000U, APP_BOARD_REFEREE_MASK)

APP_MODULE(MODULE_MAG, 12, "IST8310", 100U, APP_BOARD_IMU_MASK)
