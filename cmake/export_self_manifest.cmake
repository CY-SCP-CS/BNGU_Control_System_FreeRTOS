set(manifest_sources "")
set(manifest_includes "")
foreach(target self_os ${app_objects} self_drv self_bsp self_lib)
    get_target_property(source_dir ${target} SOURCE_DIR)
    get_target_property(sources ${target} SOURCES)
    foreach(source IN LISTS sources)
        if(source MATCHES "\\.c$")
            cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${source_dir}" NORMALIZE OUTPUT_VARIABLE absolute)
            file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${absolute}")
            list(APPEND manifest_sources "${relative}")
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES manifest_sources)
string(JOIN "\", \"" source_json ${manifest_sources})
set(include_targets ${app_objects} self_os self_drv self_bsp self_lib self_app_contracts)
set(include_expr "")
foreach(target IN LISTS include_targets)
    list(APPEND include_expr "$<TARGET_PROPERTY:${target},INCLUDE_DIRECTORIES>")
endforeach()
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/self_core_manifest.json" CONTENT
"{\n\"board\":\"${APP_BOARD}\",\n\"log_mode\":\"${APP_LOG_MODE}\",\n\"sources\":[\"${source_json}\"],\n\"includes\":[\"$<JOIN:$<REMOVE_DUPLICATES:${include_expr}>,\",\">\"]\n}\n")
